# S3 Client Configuration
# Copy this file to .env and update values as needed

# AWS Region (default: us-east-1)
S3_REGION=us-east-1

# S3 Bucket name (required)
S3_BUCKET=my-bucket

# AWS Credentials (optional if using IAM role or environment)
S3_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
S3_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Custom endpoint for S3-compatible services (optional)
# S3_ENDPOINT=http://localhost:9000

# Use path-style addressing (required for some S3-compatible services)
# S3_USE_PATH_STYLE=true

# Operation timeout (default: 30s)
# S3_TIMEOUT=30s

# Maximum retry attempts (default: 3)
# S3_MAX_RETRIES=3

# Multipart upload threshold in bytes (default: 5MB)
# S3_MULTIPART_THRESHOLD=5242880

# Part size for multipart uploads in bytes (default: 5MB)
# S3_PART_SIZE=5242880

# Maximum concurrent uploads for multipart (default: 5)
# S3_MAX_CONCURRENT_UPLOADS=5

# Enable debug logging
# S3_DEBUG=false

# Disable SSL verification (not recommended for production)
# S3_DISABLE_SSL=false
